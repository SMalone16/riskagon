{
  "name": "Riskagon • Multiplayer Hex Strategy",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Riskagon Multiplayer",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm install && npm run assets:sync",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
